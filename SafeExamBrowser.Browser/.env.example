# Copy this file to .env beside SafeExamBrowser.exe and fill in both values.
# Press Ctrl + Shift + U in SEB to read this file and begin login.
# Values inside matching single or double quotes are used literally.
CHATGPT_EMAIL=
CHATGPT_PASSWORD=
CHATGPT_LOGIN_PROVIDER=openai
# For Google sign-in, set CHATGPT_LOGIN_PROVIDER=google and use your Google password.
# Verification and consent can be completed by typing/clicking inside the login page.
